rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: solo la cuenta de Google del dueño (por UID, no por mail)
    function isAdmin() {
      return request.auth != null && request.auth.uid == '38miaym8hSf7it9StkESOmBEDk73';
    }
    // Ranking: todos leen; cada dispositivo escribe solo su propia marca, con datos razonables
    match /scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['alias', 'best', 'metros', 'char', 'at'])
        && request.resource.data.alias is string && request.resource.data.alias.size() <= 18
        && request.resource.data.best is number && request.resource.data.best > 0 && request.resource.data.best < 5000000
        && request.resource.data.metros is number && request.resource.data.metros < 100000
        && (resource == null || request.resource.data.best > resource.data.best);
      allow delete: if isAdmin();
    }
    // Partidas: cada partida terminada es una fila; todos leen, nadie edita
    match /runs/{id} {
      allow read: if true;
      // la partida tiene que ser creíble: duración, metros y puntos coherentes entre sí
      allow create: if request.resource.data.keys().hasOnly(['alias', 'pts', 'metros', 'char', 'device', 'dur', 'cause', 'at'])
        && (!('cause' in request.resource.data) || (request.resource.data.cause is string && request.resource.data.cause.size() <= 20))
        && request.resource.data.alias is string && request.resource.data.alias.size() <= 18
        && request.resource.data.pts is number && request.resource.data.pts > 0 && request.resource.data.pts < 5000000
        && request.resource.data.metros is number && request.resource.data.metros >= 0 && request.resource.data.metros < 100000
        && request.resource.data.dur is number && request.resource.data.dur >= 3 && request.resource.data.dur <= 10800
        && request.resource.data.metros <= request.resource.data.dur * 30 + 20
        && request.resource.data.pts <= request.resource.data.metros * 150 + 10000
        && request.resource.data.pts <= request.resource.data.dur * 700 + 5000
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        // tiene que venir junto con la marca de tiempo de su dispositivo (máx. 1 partida cada 8 s)
        && getAfter(/databases/$(database)/documents/lim/$(request.resource.data.device)).data.t == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Visitas: un documento por dispositivo; el contador solo sube de a 1; solo el admin las lee
    match /visits/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    // Feedback: cualquiera puede dejar uno; solo el admin lo lee
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['rating', 'comment', 'alias', 'char', 'best', 'device', 'at'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && request.resource.data.alias is string && request.resource.data.alias.size() <= 18
        && request.resource.data.device is string && request.resource.data.device.size() > 0 && request.resource.data.device.size() <= 40
        // máx. 1 comentario por minuto por dispositivo
        && getAfter(/databases/$(database)/documents/limf/$(request.resource.data.device)).data.t == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Límite de frecuencia: una marca de tiempo por dispositivo, solo puede avanzar si pasó el tiempo mínimo
    match /lim/{dev} {
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(8, 's');
      allow read, delete: if false;
    }
    match /limf/{dev} {
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
      allow update: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time
        && request.time > resource.data.t + duration.value(60, 's');
      allow read, delete: if false;
    }
  }
}
